{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gold label for one message (eval/labels/<msg_id>.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["msg_id", "labeler", "guideline_version", "intents", "priority", "risk_flags", "gold_route",
               "expected_tool_calls", "gold_kb_spans", "must_address", "difficulty_tags", "note"],
  "properties": {
    "msg_id": {"type": "string", "pattern": "^m[0-9]{3}$"},
    "labeler": {"type": "string", "minLength": 1},
    "guideline_version": {"type": "string", "minLength": 1},
    "intents": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
                "items": {"enum": ["WISMO", "RETURN_REFUND", "PRODUCT_Q", "ORDER_CHANGE", "COMPLAINT", "PRICE_DISCOUNT", "WHOLESALE", "OTHER"]}},
    "priority": {"enum": ["P0", "P1", "P2"]},
    "risk_flags": {"type": "array", "uniqueItems": true,
                   "items": {"enum": ["REFUND_REQUEST", "COMPENSATION", "PRICE_COMMIT", "DELIVERY_COMMIT", "REVIEW_THREAT", "CHARGEBACK_LEGAL", "IDENTITY_MISMATCH", "INJECTION"]}},
    "gold_route": {"enum": ["AUTO_REPLY", "DRAFT_FOR_REVIEW", "ESCALATE"]},
    "route_override": {"type": "boolean", "description": "true when gold_route was set by hand instead of derived from risk_flags; explain in note"},
    "expected_tool_calls": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "args"],
      "properties": {"name": {"enum": ["get_order", "find_orders_by_email", "get_tracking", "get_product"]}, "args": {"type": "object"}}}},
    "gold_kb_spans": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["doc_id", "lines"],
      "properties": {"doc_id": {"type": "string"}, "lines": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}}}},
    "must_address": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "difficulty_tags": {"type": "array", "items": {"type": "string"}},
    "note": {"type": "string"},
    "labeled_at": {"type": "string"}
  }
}
